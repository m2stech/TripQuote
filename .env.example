# OpenAI (server-only)
OPENAI_API_KEY=

# Google Places API (server-only, opcional) — fotos reais de hotel no builder
# PPTX (M7). Sem esta key, o slide de hotel cai no fallback (foto citada
# pela IA, ou placeholder) sem quebrar a geração.
GOOGLE_PLACES_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (sem barra final). Usada para montar o link de
# redirecionamento do e-mail de recuperação de senha. Em dev, cai em
# http://localhost:3000 se não definida.
NEXT_PUBLIC_SITE_URL=

# Sentry
SENTRY_DSN=